# Splattie configuration
# Copy to .env.local and adjust:
#   cp .env.example .env.local

# Backend GPU API URL (used when self-hosting)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Enable self-host mode: shows /create UI and links to local GPU backend.
# Set to "true" if you're running the backend locally and want to generate
# your own avatars through the web UI. Default (unset/false) shows the
# "Coming soon" placeholder used for the splattie.app deployment.
NEXT_PUBLIC_SELF_HOST=false

# --- Admin analytics panel ------------------------------------------------
# SECRETS. In production these come from Doppler and are injected at runtime
# (doppler run -- docker compose -f docker-compose.prod.yml up -d). Real values
# must NEVER be committed — the placeholders below are only for local dev.

# Password for the /admin login form.
ADMIN_PASSWORD=change-me-locally

# Signs admin session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Shared bearer token guarding the backend's /admin/stats endpoint.
# MUST be identical for the web and backend services. openssl rand -hex 32
ADMIN_API_TOKEN=

# Server-to-server URL the admin dashboard uses to read analytics
# (the docker-compose service name, not the public domain).
BACKEND_INTERNAL_URL=http://localhost:8000

# --- SEO ------------------------------------------------------------------
# Google Search Console verification token. Optional; leave blank until ready.
GOOGLE_SITE_VERIFICATION=

# --- Analytics (optional) -------------------------------------------------
# Extra salt mixed into the anonymized daily visitor hash. Optional.
STATS_SALT=
